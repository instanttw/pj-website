# Environment variables for local and Vercel

# Core site
NEXT_PUBLIC_SITE_URL=

# Supabase (existing project values if applicable)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# optional defaults
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_PATH=/checkout/success
STRIPE_CANCEL_PATH=/checkout/cancel

# PayPal
# PAYPAL_ENV: 'sandbox' or 'live'
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optionally override the API base (auto-resolves from PAYPAL_ENV if empty)
PAYPAL_API_BASE=
